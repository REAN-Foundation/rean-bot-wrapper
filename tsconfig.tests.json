{
    "compilerOptions": {
        "noEmit": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "es2020",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "tests/**/*.ts",
        "playwright.config.ts"
    ]
}
